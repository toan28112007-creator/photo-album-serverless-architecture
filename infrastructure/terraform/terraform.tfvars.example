# Copy to terraform.tfvars and fill in for your account.

aws_region   = "ap-southeast-2"
environment  = "dev"

# AWS Academy Learner Lab accounts cannot create custom IAM roles.
# Set use_lab_role = true and fill in lab_role_arn with the ARN shown
# under IAM > Roles > LabRole in your Learner Lab account.
use_lab_role = true
lab_role_arn = "arn:aws:iam::919528947811:role/LabRole"

# Leave false — see README "What's deployed vs. designed".
deploy_video_asg = false
